# Copy this file to .env for local notes, or set these in your host's dashboard (Render, Railway).
NODE_ENV=production
PORT=3000
# Long random text used to sign the admin session cookie
SESSION_SECRET=change-me-to-a-long-random-string
# Optional locally: leave both blank to create the first admin yourself on /signup.
# Set BOTH on a host with no persistent disk (Render free plan), so the admin
# account is recreated after every restart and /signup stays closed.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Set to false to start with an empty donor list instead of the 30 sample donors
SEED_DEMO=true
# Where the SQLite file is stored
DB_PATH=./data/bloodlink.db
